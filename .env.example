# Required
ANTHROPIC_API_KEY=your_key_here
DISCORD_WEBHOOK_URL=your_webhook_here

# Optional - only needed if you want the system to read your replies
# automatically (APPROVE/SKIP/STATUS etc). Webhooks alone cannot read
# channel messages, so this requires a Discord bot user.
# See README.md "Discord Reply Reading" section for setup steps.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Display
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# Schedule (24hr format)
SURVEILLANCE_TIME=06:00
DAILY_BRIEF_TIME=07:00
MONITORING_TIME=08:00
CONTENT_BRIEF_TIME=10:00
EVENING_SWEEP_TIME=18:00

# System limits
MAX_ACTIVE_STORES=3
MAX_AGENT_ITERATIONS=50
MIN_TIKTOK_ORDERS_PER_DAY=200
MIN_TIKTOK_GROWTH_PERCENT=100
MIN_META_AD_AGE_DAYS=90
MIN_META_AD_INTERACTIONS=10000

# Thresholds
ORGANIC_SAVE_RATE_THRESHOLD=0.02
PAID_CTR_THRESHOLD=0.03
ROAS_CUT_THRESHOLD=2.0
ROAS_SCALE_THRESHOLD=3.0
ROAS_CUT_CONSECUTIVE_DAYS=3
ROAS_SCALE_CONSECUTIVE_DAYS=2

# Margins
MIN_GROSS_MARGIN=30
MIN_COGS_MULTIPLIER=3.0

# Operator
OPERATOR_NAME=Ethan
MAX_DAILY_AD_SPEND=250
